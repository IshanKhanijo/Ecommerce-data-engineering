from pyspark.sql.functions import col, to_date, date_diff, current_date, when
def clean_dataframe(df,name):
    print("Cleaning: ",name)
    return df.dropDuplicates().na.drop("all")

orders_df = clean_dataframe(orders_df,"orders_df")
display(orders_df)
orders_df = orders_df.withColumn("order_purchase_timestamp", to_date(col("order_purchase_timestamp")))\
    .withColumn("order_delivered_customer_date", to_date(col("order_delivered_customer_date")))\
        .withColumn("order_estimated_delivery_date", to_date(col("order_estimated_delivery_date")))
# Calculate Delivery Date and Time Delays
orders_df = orders_df.withColumn("actual_delivery_time", date_diff(col("order_delivered_customer_date"), col("order_purchase_timestamp")))
orders_df = orders_df.withColumn("estimated_delivery_time", date_diff("order_estimated_delivery_date", "order_purchase_timestamp"))
orders_df = orders_df.withColumn("delay_time", col("actual_delivery_time") - col("estimated_delivery_time"))

display(orders_df)
