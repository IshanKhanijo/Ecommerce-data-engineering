def remove_duplicate_columns(df):
    columns = df.columns
    unique_columns = set()
    solumns_to_drop=[]

    for column in columns:
        if column in unique_columns:
            solumns_to_drop.append(column)
        else:
            unique_columns.add(column)

    df_cleaned = df.drop(*solumns_to_drop)
    return df_cleaned

final_df1 = remove_duplicate_columns(final_df1)
# Serving the final aggregated and joined data to the *silver layer*
final_df1.write.mode("overwrite").parquet(f"abfss://olistdata@{storage_account}.dfs.core.windows.net/silver")
